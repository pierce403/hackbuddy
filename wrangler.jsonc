{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackbuddy-io",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "build/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "READ_ONLY": "true",
    "STAGING": "false",
    "AUTH_DOMAIN": "hackbuddy.io"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "hackbuddy-io-staging",
      "routes": [],
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "READ_ONLY": "false",
        "STAGING": "true",
        "AUTH_DOMAIN": "hackbuddy-io-staging.bcrt43.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "STAGING_DB",
          "database_name": "hackbuddy-staging",
          "database_id": "a7c6b001-fe06-4890-8c2a-cdef4292a515"
        }
      ]
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hackbuddy-production",
      "database_id": "b40bdd2e-f905-48a8-8355-d6bec290e292",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "hackbuddy.io/*",
      "zone_id": "747b1113bf181eef96a4ce7d950c811a"
    }
  ]
}
